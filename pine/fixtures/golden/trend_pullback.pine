//@version=6
// ARF-OS Strategy ID: 0192f1a0-0000-7000-8000-000000000020
// Strategy Version ID: 0192f1a0-0000-7000-8000-000000000021
// SDL Hash: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
// Source Hash: generated after save
// Parent Version ID: none
// Research Campaign ID: 0192f1a0-0000-7000-8000-000000000022
// Pine Version: 6
// Generated by: PINE_ENGINEER
// Human reviewed: false
strategy("ARF Example Trend Pullback", overlay = true, initial_capital = 10000, currency = currency.USDT, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.06, slippage = 2, pyramiding = 0, margin_long = 33.33, margin_short = 33.33, process_orders_on_close = false, calc_on_every_tick = false, calc_on_order_fills = false)

// ---- Inputs ----------------------------------------------------------------
fast_length = input.int(20, "Fast EMA", minval = 10, maxval = 50, step = 5)
slow_length = input.int(100, "Slow EMA", minval = 60, maxval = 200, step = 10)
stop_atr = input.float(2.0, "Stop ATR multiple", minval = 1.0, maxval = 4.0, step = 0.25)
target_r = input.float(2.0, "Target R multiple", minval = 1.0, maxval = 4.0, step = 0.25)
start_date = input.time(timestamp("2020-01-01T00:00:00Z"), "Segment start")
end_date = input.time(timestamp("2099-01-01T00:00:00Z"), "Segment end")
deployment_id = input.string("unassigned", "ARF deployment id")

// ---- Data requests (confirmed higher-timeframe value) -----------------------
htf_close = request.security(syminfo.tickerid, "240", close[1], lookahead = barmerge.lookahead_on)

// ---- Indicators --------------------------------------------------------------
fast = ta.ema(close, fast_length)
slow = ta.ema(close, slow_length)
atr = ta.atr(14)

// ---- Regime, session and segment filters ------------------------------------
in_window = time >= start_date and time < end_date
in_session = not na(time(timeframe.period, "0000-2359:1234567", "Etc/UTC"))
trend_fast_above_slow = fast > slow and close > htf_close
trend_fast_below_slow = fast < slow and close < htf_close
pullback_recovery = low < fast and close > fast
pullback_rejection = high > fast and close < fast
flat = strategy.position_size == 0

// ---- Entry conditions (closed bars only) ------------------------------------
long_signal = true and barstate.isconfirmed and in_window and in_session and flat and trend_fast_above_slow and pullback_recovery
short_signal = true and barstate.isconfirmed and in_window and in_session and flat and trend_fast_below_slow and pullback_rejection

// ---- Alerts --------------------------------------------------------------------
alert_payload(string event_type, string order_id, float stop_price, float target_price) =>
    '{"schema":"arf.signal.v1","deploymentId":"' + deployment_id + '","strategyVersionId":"0192f1a0-0000-7000-8000-000000000021","eventId":"' + order_id + '-' + str.tostring(time) + '","eventType":"' + event_type + '","orderId":"' + order_id + '","symbol":"' + syminfo.prefix + ':' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","barTime":"' + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '","sentAt":"' + str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '","price":' + str.tostring(close) + ',"quantityModel":"percent_of_equity","stopPrice":' + str.tostring(stop_price) + ',"targetPrice":' + str.tostring(target_price) + '}'

// ---- Orders: one stop and one target, market entry on the next bar ----------
if long_signal
    long_stop = close - stop_atr * atr
    long_target = close + target_r * stop_atr * atr
    strategy.entry("L", strategy.long, alert_message = alert_payload("ENTRY_LONG", "L", long_stop, long_target))
    strategy.exit("L-exit", from_entry = "L", stop = long_stop, limit = long_target)

if short_signal
    short_stop = close + stop_atr * atr
    short_target = close - target_r * stop_atr * atr
    strategy.entry("S", strategy.short, alert_message = alert_payload("ENTRY_SHORT", "S", short_stop, short_target))
    strategy.exit("S-exit", from_entry = "S", stop = short_stop, limit = short_target)

// ---- Diagnostics -----------------------------------------------------------------
plot(fast, "Fast EMA", color = color.teal)
plot(slow, "Slow EMA", color = color.orange)
