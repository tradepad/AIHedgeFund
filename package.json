{
  "name": "arf-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @arf/integration-tests test:integration",
    "test:e2e": "pnpm --filter @arf/web test:e2e",
    "db:generate": "pnpm --filter @arf/db db:generate",
    "db:migrate": "pnpm --filter @arf/db db:migrate",
    "db:seed": "pnpm --filter @arf/db db:seed",
    "import:external": "pnpm --filter @arf/api import:external",
    "schemas:generate": "pnpm --filter @arf/contracts schemas:generate",
    "services:up": "bash infra/scripts/dev-services.sh up",
    "services:down": "bash infra/scripts/dev-services.sh down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
