{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "thesis": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "directions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          }
        }
      },
      "required": [
        "name",
        "family",
        "thesis",
        "directions"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "assetClass": {
          "type": "string",
          "enum": [
            "crypto",
            "equity",
            "fx",
            "futures",
            "index",
            "commodity"
          ]
        },
        "symbols": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+:[A-Z0-9._!-]+$"
          }
        },
        "timeframe": {
          "type": "string",
          "pattern": "^(\\d+|\\d*[DWM]|\\d+S)$"
        },
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z]+(?:\\/[A-Za-z0-9_+-]+)*$"
        },
        "session": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}(:[1-7]+)?$"
        },
        "chartType": {
          "type": "string",
          "const": "standard_ohlc"
        }
      },
      "required": [
        "assetClass",
        "symbols",
        "timeframe",
        "timezone",
        "session",
        "chartType"
      ],
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "properties": {
        "longEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(\\(|\\)|\\s|AND|OR|NOT|[a-z][a-z0-9_]*)+$"
        },
        "shortEntry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(\\(|\\)|\\s|AND|OR|NOT|[a-z][a-z0-9_]*)+$"
        },
        "longExit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(\\(|\\)|\\s|AND|OR|NOT|[a-z][a-z0-9_]*)+$"
        },
        "shortExit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(\\(|\\)|\\s|AND|OR|NOT|[a-z][a-z0-9_]*)+$"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "parameter": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    }
                  },
                  "required": [
                    "parameter"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(\\(|\\)|\\s|AND|OR|NOT|[a-z][a-z0-9_]*)+$"
          }
        ]
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "entryOrder": {
          "type": "string",
          "enum": [
            "market_next_bar",
            "limit",
            "stop"
          ]
        },
        "pyramiding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "allowReversal": {
          "type": "boolean"
        },
        "processOnClose": {
          "type": "boolean"
        },
        "calcOnEveryTick": {
          "type": "boolean"
        }
      },
      "required": [
        "entryOrder",
        "pyramiding",
        "allowReversal",
        "processOnClose",
        "calcOnEveryTick"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "sizingModel": {
          "type": "string",
          "enum": [
            "percent_of_equity",
            "fixed_quantity",
            "fixed_cash"
          ]
        },
        "sizePercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fixedQuantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fixedCash": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leverage": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "stopLoss": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "atr_multiple",
                "percent",
                "fixed_ticks",
                "risk_multiple"
              ]
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "valueParameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "takeProfit": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "atr_multiple",
                "percent",
                "fixed_ticks",
                "risk_multiple"
              ]
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "valueParameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "oneStopOneTarget": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "sizingModel",
        "leverage",
        "stopLoss",
        "takeProfit",
        "oneStopOneTarget"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "commissionType": {
          "type": "string",
          "enum": [
            "percent",
            "cash_per_order",
            "cash_per_contract"
          ]
        },
        "commissionValue": {
          "type": "number",
          "minimum": 0
        },
        "slippageTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "commissionType",
        "commissionValue",
        "slippageTicks"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "int",
                  "float"
                ]
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "type",
              "default",
              "min",
              "max",
              "step"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "bool"
              },
              "default": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "type",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "segments": {
      "type": "object",
      "properties": {
        "warmupBars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selectionMode": {
          "type": "string",
          "enum": [
            "fixed",
            "rolling_walk_forward",
            "anchored_walk_forward",
            "regime"
          ]
        },
        "embargoBars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "warmupBars",
        "selectionMode",
        "embargoBars"
      ],
      "additionalProperties": false
    },
    "falsification": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "required": [
    "schemaVersion",
    "strategy",
    "market",
    "signals",
    "execution",
    "risk",
    "costs",
    "parameters",
    "segments",
    "falsification"
  ],
  "additionalProperties": false,
  "$id": "https://arf-os.dev/schemas/strategy-definition/1.0.0"
}
