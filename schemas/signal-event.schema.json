{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "arf.signal.v1"
    },
    "deploymentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "strategyVersionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "eventId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "eventType": {
      "type": "string",
      "enum": [
        "ENTRY_LONG",
        "ENTRY_SHORT",
        "EXIT_LONG",
        "EXIT_SHORT",
        "STOP_HIT",
        "TARGET_HIT",
        "HEARTBEAT"
      ]
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+:[A-Z0-9._!-]+$"
    },
    "timeframe": {
      "type": "string",
      "pattern": "^(\\d+|\\d*[DWM]|\\d+S)$"
    },
    "barTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quantityModel": {
      "type": "string",
      "enum": [
        "percent_of_equity",
        "fixed_quantity",
        "fixed_cash"
      ]
    },
    "stopPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "targetPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema",
    "deploymentId",
    "strategyVersionId",
    "eventId",
    "eventType",
    "orderId",
    "symbol",
    "timeframe",
    "barTime",
    "sentAt",
    "price",
    "quantityModel"
  ],
  "additionalProperties": false,
  "$id": "https://arf-os.dev/schemas/signal-event/1.0.0"
}
