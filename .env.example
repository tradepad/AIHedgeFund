# ARF-OS local development configuration. Copy to .env and adjust.
# Never commit .env. Development values below are placeholders, not secrets.

# --- Shared (API and all workers) ------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://arf@127.0.0.1:5432/arf
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info

# Object storage. `local` is a development driver (filesystem + HMAC-signed
# upload URLs); production must use `s3` (any S3-compatible store).
STORAGE_DRIVER=local
# Absolute path, shared by the API and all workers.
LOCAL_STORAGE_DIR=/absolute/path/to/aihedgefund/.data/objects
# At least 32 characters. Generate with: openssl rand -hex 32
LOCAL_STORAGE_SIGNING_SECRET=replace-with-32-plus-random-characters
# Base URL the browser uses for presigned uploads. With the local driver this is
# the web app's same-origin proxy, so uploads never need CORS.
UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/arf-api
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=arf-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- API (apps/api) ----------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# `dev` accepts `Bearer dev:<subject>` for seeded development users and is
# refused when NODE_ENV=production. `clerk` verifies Clerk session tokens.
AUTH_MODE=dev
# CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Requests per minute per credential on upload-completion and other rate-limited commands.
RATE_LIMIT_MAX=30
OUTBOX_RELAY_ENABLED=true
ORCHESTRATOR_ENABLED=true

# --- Workers (apps/worker-*) ---------------------------------------------------
WORKER_CONCURRENCY=4
# Each worker serves /healthz and /readyz on its own port:
# worker-backtest 4101, worker-analytics 4102, worker-research 4103, worker-forward 4104.
# Set HEALTH_PORT per process to override.
# worker-research: only the deterministic fixture provider exists in this slice.
MODEL_PROVIDER=fixture
FIXTURE_PROVIDER_MODE=valid

# --- Web (apps/web) ------------------------------------------------------------
ARF_API_URL=http://127.0.0.1:4000
# `dev` shows the development user picker. Clerk front-end sign-in is not part of this slice.
ARF_AUTH_MODE=dev
